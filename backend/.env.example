# Copy this file to `.env` and fill in your own values.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dharamshala?retryWrites=true&w=majority

# JWT signing secret — required, no default. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed CORS origins (your deployed frontend URL(s))
ALLOWED_ORIGINS=http://localhost:5173

# Razorpay payment gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Used only by createAdmin.js (one-off admin bootstrap script)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_PHONE=
